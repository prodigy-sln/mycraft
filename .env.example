# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# These are BUILD-TIME asset generation credentials only. They are used by
# tools/asset-gen to produce files under assets/, which are committed. The game
# never reads them and never contacts these services at runtime — see ADR-009.
# A shipped client contains no API keys.

# ElevenLabs — sound effects, music, character voices.
# Required scopes: text_to_speech, sound_generation, voices_read.
# Also grant user_read so the tooling can check remaining quota before
# generating; without it, generation runs blind against your character budget.
ELEVENLABS_API_KEY=

# fal.ai — texture and icon generation.
# Balance is queryable, so the generator enforces a spend ceiling per run.
FAL_API_KEY=
