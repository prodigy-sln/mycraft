# A carpenter's workbench: four legs, a plank top, a shelf underneath, a
# pegboard standing off the back edge with tools hung on it, and an iron vice
# clamped over the near right corner.
#
# Sliced on `z`, so each layer is a front elevation and the whole bench is
# nine of them, back to front. The first row printed is the top of the
# pegboard and the first column is x = 0, the left end. z = 0 is the board
# plane and z = 8 is the vice's outer jaw, hanging past the bench's front edge.
#
# Revision 2, after a reviewer read the fourteen views:
#
#   * The vice was a plain grey cube parked on the top — an ingot, an anvil, a
#     rock somebody set down. It is now two jaws with a gap between them,
#     bridged by a screw through the middle, and it hangs one voxel past the
#     front edge. A vice bolted to an edge is instantly a vice; a cube in the
#     middle of a table is cargo. The handle stub sticks out the right side.
#   * The board and the worktop fused into one slab head-on, because their
#     front faces were coplanar and direction shading gave them one value. The
#     board is now inset one voxel at each end, so the top projects past it on
#     both sides and the bench keeps its most important line — the horizontal
#     of the work surface.
#   * The board's right half was bare, and an empty pegboard reads as a panel,
#     and a panel reads as furniture. Two chisels and a coil now hang there.
#   * The saw's handle was iron, which made it an abstract bracket. It is wood,
#     and the saw names itself.
#   * From behind the bench was a blank wall. A brace now runs up the board's
#     back, one voxel per course.
#
# What makes it a *work*bench rather than a table is the asymmetry: tools at
# one end of the board, the vice at the other end of the top, the shelf set
# back between the legs. A symmetric bench reads as furniture. Deliberately
# not mirror-symmetric on any axis.
#
# The tools hang one voxel proud of the board rather than being drawn into it,
# so they cast their own shading and read as objects rather than as paint.
# Each still shares a face with the board behind it.
#
# 556 filled voxels in a 14 x 18 x 9 box.

schema = 1
name   = "base:workbench"
scale  = 16
size   = [14, 18, 9]
origin = [7, 0, 4]        # centre of the footprint, floor level
slice  = "z"

[palette]
"." = "empty"
"w" = "base:oak_beam"
"k" = "base:oak_plank"
"i" = "base:iron"

[[layers]]                # z = 0, the pegboard, its brace, and the back legs
z = 0
grid = """
.kkkkkwkkkkkk.
.kkkkwkkkkkkk.
.kkkwkkkkkkkk.
.kkwkkkkkkkkk.
.kwkkkkkkkkkk.
.wkkkkkkkkkkk.
kkkkkkkkkkkkkk
kkkkkkkkkkkkkk
ww..........ww
ww..........ww
ww..........ww
ww..........ww
ww..........ww
ww..........ww
ww..........ww
ww..........ww
ww..........ww
ww..........ww
"""

[[layers]]                # z = 1, the tools, hung proud of the board
z = 1
grid = """
..............
..............
..ii.wwiiiii..
..w..wwiiii...
..w.i.iww.....
..w.i.iww.....
kkkkkkkkkkkkkk
kkkkkkkkkkkkkk
ww..........ww
ww..........ww
ww..........ww
ww..........ww
ww..........ww
ww..........ww
wwkkkkkkkkkkww
ww..........ww
ww..........ww
ww..........ww
"""

[[layers]]                # z = 2, open span: top and shelf only
z = 2
grid = """
..............
..............
..............
..............
..............
..............
kkkkkkkkkkkkkk
kkkkkkkkkkkkkk
..............
..............
..............
..............
..............
..............
..kkkkkkkkkk..
..............
..............
..............
"""

[[layers]]                # z = 3
z = 3
