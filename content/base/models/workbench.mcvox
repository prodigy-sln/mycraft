..............
..............
..............
"""

[[layers]]                # z = 5
z = 5
grid = """
..............
..............
..............
..............
..............
..............
kkkkkkkkkkkkkk
kkkkkkkkkkkkkk
..............
..............
..............
..............
..............
..............
..kkkkkkkkkk..
..............
..............
..............
"""

[[layers]]                # z = 6, the vice's fixed jaw; front legs begin
z = 6
grid = """
..............
..............
..............
..............
..........iii.
..........iii.
kkkkkkkkkkkkkk
kkkkkkkkkkkkkk
ww..........ww
ww..........ww
ww..........ww
ww..........ww
ww..........ww
ww..........ww
wwkkkkkkkkkkww
ww..........ww
ww..........ww
ww..........ww
"""

[[layers]]                # z = 7, the gap between the jaws, and the screw
z = 7
