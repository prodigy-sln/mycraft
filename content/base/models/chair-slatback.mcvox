# A slat-backed chair with armrests, modelled from a reference render.
#
# Sliced on `y`, so each layer is a floor plan: the first row printed is z = 0,
# the back of the chair, and the last is the front. Read downward the layers go
# legs, stretchers, seat, armrests, then the back panel rising on its own.
#
# Revision 4, after a reviewer read the fourteen views: the arm, its post and
# the leg beneath it now share the same two columns — they were offset by one,
# so half of each arm hung off the edge of its own post — and the seat reaches
# back to z = 2 so the back panel rests on it rather than on air.
#
# Mirror-symmetric about x = 5. The two arms differing in a corner view is the
# near one occluding differently from the far one, not an asymmetry.
#
# 376 filled voxels in an 11 x 18 x 12 box.

schema = 1
name   = "base:chair_slatback"
scale  = 16
size   = [11, 18, 12]
origin = [5, 0, 6]
slice  = "y"

[palette]
"." = "empty"
"w" = "base:oak_beam"

[[layers]]
y = 0
grid = """
...........
...........
ww.......ww
ww.......ww
...........
...........
...........
...........
ww.......ww
ww.......ww
...........
...........
"""

[[layers]]
y = 1
grid = """
...........
...........
ww.......ww
ww.......ww
...........
...........
...........
...........
ww.......ww
ww.......ww
...........
...........
"""

