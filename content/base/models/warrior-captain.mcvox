# A captain of Aurelmoor: armoured, sword raised, shield on the left arm.
#
# Sliced on `z`, so each layer is a front elevation and the figure is seven of
# them, back to front. The first row printed is the sword's tip and the first
# column is x = 0, the outer edge of the shield.
#
# **z = 6 is the shield face and z = 0 is the cloak**, because a `front` render
# looks down the axis from high z toward low. The first cut had this backwards
# and the front elevation was a blue rectangle — a cloak seen from behind,
# with the shield and the livery hidden on the far side. Worth stating rather
# than rediscovering: the layer you want the camera to meet first is the
# *last* one you declare.
#
# The figure was rebuilt once already, after a reviewer called it a chess
# bishop holding a pole. That diagnosis was proportion, not colour, and it is
# the same lesson three animals in this set taught in a different costume:
# **a figure is a ratio before it is a set of parts.** Twenty-seven courses on
# a 5-wide, 3-deep torso is seven heads — life drawing, not voxel art. Voxel
# figures read at four to five. It is now 25 courses on an 8-wide, 4-deep
# torso, and every separation below was only possible once that changed:
#
#   * **The arms stand a voxel clear of the torso**, with a gold pauldron
#     capping each shoulder to bridge the gap. Steel arms flush against a
#     steel torso are one slab — they separate only where the directional
#     shading happens to disagree, and that is not a silhouette.
#   * **The legs have a two-voxel gap and dark greaves up most of their
#     length.** A one-voxel gap survives the front elevation and closes in
#     every isometric projection, which is where it matters.
#   * **The sword is in front of the arm rather than beside it.** Blade, grip
#     and crossguard live in the two front depth layers and the arm in the two
#     behind, so they share columns without fighting for them, and a dark fist
#     bridges the two — which is what "held" looks like when a voxel cannot be
#     in two places at once.
#   * **The crossguard is twice the blade's width and centred on it.** A guard
#     the blade's own width does not exist at this scale, and one that is
#     wider on a single side reads as a signpost.
#
# **The shield carries one charge, not three.** The revision before this had a
# steel rim, a gold cross *and* a steel boss inside a four-voxel field, and
# they interfered into vertical stripes — a heraldic paly, which is a
# different coat of arms than the one intended. The rule that fell out of it:
# **at this size a shield gets one focal element.** It is now a steel rim, a
# blue field, a gold ring and a steel boss dead centre — the kingdom's two
# colours meeting at the middle of the shield, with nothing competing.
#
# **The kingdom is two colours used as heraldry, not decoration.** Aurelmoor
# is blue and gold, and nothing may use them except where the kingdom is being
# declared: shield, tabard, belt, cloak hem, pauldrons, crest. The cloak is a
# darker blue than the shield's field on purpose — at the same value the two
# read as the same rectangle from behind, and a reviewer genuinely could not
# tell which was which.
#
# **He is the leader, and three things say so**, none of which is a bigger
# weapon: a crest one voxel wide running fore and aft along the helm's
# centreline and sloping down toward the front, the cloak — nobody in a shield
# wall wears one — and the sword held upright rather than couched, which is
# the posture of somebody signalling rather than fighting.
#
# Deliberately **not mirror-symmetric**: shield left, sword right.
#
# 943 filled voxels in a 19 x 25 x 7 declared box, trimming to 18 wide — the
# crossguard no longer reaches the last column.

schema = 1
name   = "base:warrior_captain"
scale  = 16
size   = [19, 25, 7]
origin = [9, 0, 3]        # between the boots, on the figure's centreline
slice  = "z"

[palette]
"." = "empty"
"S" = "base:steel"
"D" = "base:steel_dark"
"B" = "base:royal_blue"
"C" = "base:royal_blue_dark"
"G" = "base:royal_gold"
"L" = "base:leather_grip"
"E" = "base:iron_edge"

[[layers]]                # z = 0, the cloak
z = 0
grid = """
...................
...................
...................
...................
...................
...................
...................
...................
......CCCCCCCC.....
......CCCCCCCC.....
......CCCCCCCC.....
......CCCCCCCC.....
......CCCCCCCC.....
......CCCCCCCC.....
......CCCCCCCC.....
......CCCCCCCC.....
......CCCCCCCC.....
......CCCCCCCC.....
......CCCCCCCC.....
......CCCCCCCC.....
......GGGGGGGG.....
...................
...................
...................
...................
"""

[[layers]]                # z = 1, the backplate, the crest's tall rear
z = 1
grid = """
.........G.........
.........G.........
.........G.........
........SSSS.......
........SSSS.......
........SSSS.......
........SSSS.......
.........DD........
...GGGSSSSSSSSGGG..
...GGGSSSSSSSSGGG..
......SSSSSSSS.SS..
......SSSSSSSS.SS..
......SSSSSSSS.SS..
......SSSSSSSS.SS..
......SSSSSSSS.....
......GGGGGGGG.....
......SSS..SSS.....
......SSS..SSS.....
......DDD..DDD.....
......DDD..DDD.....
......DDD..DDD.....
......DDD..DDD.....
......DDD..DDD.....
......DDD..DDD.....
......DDD..DDD.....
"""

