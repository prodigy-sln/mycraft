# A fox.
#
# Sliced on `y`, so each layer is a floor plan: the first row printed is z = 0,
# the tail end, and the last is the nose. Read downward the layers go paws,
# legs, belly, body and tail base, head and tail plume, then the ears alone.
#
# Cute is mostly proportion. The head is as tall as the body, the ears stand
# clear of the skull, the legs are stubby and the tail is nearly as big as the
# animal — realism would shrink all four.
#
# 482 filled voxels in a 9 x 13 x 16 box, mirror-symmetric about x = 4.

schema = 1
name   = "base:fox"
scale  = 16
size   = [9, 13, 16]
origin = [4, 0, 8]
slice  = "y"

[palette]
"." = "empty"
"f" = "base:fox_fur"
"c" = "base:fox_cream"
"s" = "base:fox_soot"

[[layers]]
y = 0
grid = """
.........
.........
.........
.........
.ss...ss.
.ss...ss.
.........
.........
.........
.........
.........
.ss...ss.
.ss...ss.
.........
.........
.........
"""

