# A cyberpunk street car: a long low body on fat tyres, with a glasshouse
# cabin set back over the rear axle, a light bar at each end and neon along
# the rocker.
#
# Sliced on `x`, so each layer is a side elevation — the profile a car is
# recognised from. The first row printed is the roof and the first column is
# z = 0, behind the tail. Columns run z = 0 → 23, so the car faces right.
#
# `scale = 8` rather than 16. Scale is voxels per block edge, so eight makes
# this 2.6 blocks long, 1.25 wide and 1.1 tall — a car, not a toy.
#
# Revision 3. Revision 1 was a symmetric ziggurat with glass only on its roof;
# revision 2 fixed the stance, wrapped the glass round the cabin and gave the
# car a direction. What this round is about is the difference between a car
# and a car-shaped box:
#
#   * Deck 4, cabin 8, hood 9. The cabin sat centred, which reads as a shooting
#     brake at best and a van at worst; pushed back over the rear axle it reads
#     as a coupe. This is the largest single silhouette change in the model.
#   * The rake is packed into the front five columns, two courses per run
#     instead of three. Spread out it read as terracing; tight it reads as a
#     taper.
#   * The nose light is backed by body rather than jutting past the silhouette
#     on its own. It was the one thing in the model that looked like an error
#     instead of a choice.
#   * Wheel arches: the body's bottom course is cut away over each wheel,
#     leaving a voxel at each end of the arch so the wheel still meets the
#     body. Tyres standing proud of an uncut flank read as bolted-on cubes.
#   * The glass is brighter and more saturated. A window should be bright
#     because it is glass, not because it is lit — at the old value the neon
#     beltline beneath it won, and the eye read two lights with a dark gap
#     instead of a window.
#
# One colour per height band: magenta on the rocker, which is the same course
# seen as underglow from below, magenta again on the upper long edge and the
# tail bar, cyan at the beltline under the glass and on the nose. All are
# emissive and render unshaded, which is why they hold on the faces the
# shading darkens most.
#
# 800 filled voxels in a 10 x 9 x 24 box, trimming to 21 voxels of length.

schema = 1
name   = "base:car_cyber"
scale  = 8
size   = [10, 9, 24]
origin = [5, 0, 12]       # centre of the wheelbase, at road level
slice  = "x"

[palette]
"." = "empty"
"b" = "base:car_body"
"g" = "base:car_glass"
"t" = "base:tire"
"n" = "base:neon_cyan"
"m" = "base:neon_magenta"

[[layers]]                # x = 0, outboard tyre wall
x = 0
grid = """
........................
........................
........................
........................
........................
........................
..ttttt.......ttttt.....
..ttttt.......ttttt.....
...ttt.........ttt......
"""

[[layers]]                # x = 1, flank: glass, beltline, rocker, arches
x = 1
grid = """
........................
.....gggggggg...........
..mbbggggggggbbbbb......
.bbbbnnnnnnnnbbbbbbb....
.mbbbbbbbbbbbbbbbbbbbn..
..b...bmmmmmmmb...bbbb..
..ttttt.......ttttt.....
..ttttt.......ttttt.....
...ttt.........ttt......
"""

[[layers]]                # x = 2, roof plate begins
x = 2
grid = """
......bbbbbb............
.....gggggggg...........
..mbbggggggggbbbbb......
.bbbbbbbbbbbbbbbbbbb....
.mbbbbbbbbbbbbbbbbbbbn..
..bbbbbbbbbbbbbbbbbbbb..
........................
........................
........................
"""

[[layers]]                # x = 3
x = 3
grid = """
......bbbbbb............
.....gggggggg...........
..mbbggggggggbbbbb......
.bbbbbbbbbbbbbbbbbbb....
.mbbbbbbbbbbbbbbbbbbbn..
..bbbbbbbbbbbbbbbbbbbb..
........................
........................
........................
"""

[[layers]]                # x = 4, centreline
x = 4
grid = """
......bbbbbb............
.....gggggggg...........
..mbbggggggggbbbbb......
.bbbbbbbbbbbbbbbbbbb....
.mbbbbbbbbbbbbbbbbbbbn..
..bbbbbbbbbbbbbbbbbbbb..
........................
........................
........................
"""

[[layers]]                # x = 5, mirror of x = 4
x = 5
grid = """
......bbbbbb............
.....gggggggg...........
..mbbggggggggbbbbb......
.bbbbbbbbbbbbbbbbbbb....
.mbbbbbbbbbbbbbbbbbbbn..
..bbbbbbbbbbbbbbbbbbbb..
........................
........................
........................
"""

[[layers]]                # x = 6, mirror of x = 3
x = 6
grid = """
......bbbbbb............
.....gggggggg...........
..mbbggggggggbbbbb......
.bbbbbbbbbbbbbbbbbbb....
.mbbbbbbbbbbbbbbbbbbbn..
..bbbbbbbbbbbbbbbbbbbb..
........................
........................
........................
"""

[[layers]]                # x = 7, mirror of x = 2
x = 7
grid = """
......bbbbbb............
.....gggggggg...........
..mbbggggggggbbbbb......
.bbbbbbbbbbbbbbbbbbb....
.mbbbbbbbbbbbbbbbbbbbn..
..bbbbbbbbbbbbbbbbbbbb..
........................
........................
........................
"""

[[layers]]                # x = 8, mirror of x = 1
x = 8
grid = """
........................
.....gggggggg...........
..mbbggggggggbbbbb......
.bbbbnnnnnnnnbbbbbbb....
.mbbbbbbbbbbbbbbbbbbbn..
..b...bmmmmmmmb...bbbb..
..ttttt.......ttttt.....
..ttttt.......ttttt.....
...ttt.........ttt......
"""

[[layers]]                # x = 9, mirror of x = 0
x = 9
grid = """
........................
........................
........................
........................
........................
........................
..ttttt.......ttttt.....
..ttttt.......ttttt.....
...ttt.........ttt......
"""
