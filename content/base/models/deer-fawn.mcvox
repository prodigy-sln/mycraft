# A young deer — a fawn, standing.
#
# Sliced on `x`, so each layer is a side elevation. The first row printed is
# the ear tips and the first column is z = 0, the tail end; columns run
# z = 0 → 12, so the fawn faces right.
#
# Revision 2, after a reviewer said it read as a deer but as a small adult
# doe. The audit that produced that verdict is worth keeping, because it is
# the same audit the rabbit needed: youth is **big head, short neck, short
# legs, features high on the face**, and the first cut had exactly one of the
# four. What changed:
#
#   * The head grew a voxel in every dimension and the barrel lost two of
#     length, which takes head-to-body from about a third to about 45 per
#     cent. That ratio is the whole of "young" — a leggy animal with a big
#     head reads as a fawn, and the same animal with a small head reads as a
#     doe, which is why the legs were left alone rather than shortened first.
#   * Spots on the **top** faces, flanking the spine. There were none, and the
#     back is the most-seen surface on a knee-high animal because a player
#     looks down at it. The flank spots also lost their grid: they sat in two
#     evenly spaced rows, which reads as a fabric print rather than as
#     dappling.
#   * The ears are longer and set back along the skull rather than standing on
#     top of it, which is what made them read as horn buds from the rear
#     corners — a goat kid rather than a fawn.
#   * The cream belly band was a ruler-straight stripe the length of the
#     flank, reading as a saddle strap. It now steps up at the chest.
#   * The hind leg steps back a voxel at the hock. It is one voxel per leg and
#     it converts "generic quadruped" to "deer" in profile.
#
# The short neck was the one youth cue the first cut had, and it is untouched.
#
# Mirror-symmetric about x = 3. 412 filled voxels in a 7 x 15 x 13 box.

schema = 1
name   = "base:deer_fawn"
scale  = 16
size   = [7, 15, 13]
origin = [3, 0, 6]        # between the forehooves, on the centreline
slice  = "x"

[palette]
"." = "empty"
"d" = "base:fawn_hide"
"c" = "base:fox_cream"
"h" = "base:hoof_dark"
"e" = "base:fox_soot"

[[layers]]                # x = 0, the left ear, set back along the skull
x = 0
grid = """
.......ddd...
.......ddd...
.............
.............
.............
.............
.............
.............
.............
.............
.............
.............
.............
.............
.............
"""

[[layers]]                # x = 1, the flank: eye, spots, outer legs
x = 1
grid = """
.........dddd
.........dedd
.........dddd
.........dddd
.ddddddddd...
.dcdddcddd...
.dddcdddcd...
.dddddcccc...
.cccccdddd...
..dd...dd....
..dd...dd....
..dd...dd....
.dd....dd....
.dd....dd....
.hh....hh....
"""

[[layers]]                # x = 2, dorsal spots flanking the spine
x = 2
grid = """
.........dddd
.........dddd
.........dddd
..........ddd
.ddcddcddc...
.ddddddddd...
.ddddddddd...
.dddddcccc...
.cccccdddd...
..dd...dd....
..dd...dd....
..dd...dd....
.dd....dd....
.dd....dd....
.hh....hh....
"""

[[layers]]                # x = 3, the centreline: nose, tail, no legs
x = 3
grid = """
.........dddd
.........dddd
.........dddd
..........dde
.ddddddddd...
cddddddddd...
cddddddddd...
.dddddcccc...
.cccccdddd...
.............
.............
.............
.............
.............
.............
"""

[[layers]]                # x = 4, mirror of x = 2
x = 4
grid = """
.........dddd
.........dddd
.........dddd
..........ddd
.ddcddcddc...
.ddddddddd...
.ddddddddd...
.dddddcccc...
.cccccdddd...
..dd...dd....
..dd...dd....
..dd...dd....
.dd....dd....
.dd....dd....
.hh....hh....
"""

[[layers]]                # x = 5, mirror of x = 1
x = 5
grid = """
.........dddd
.........dedd
.........dddd
.........dddd
.ddddddddd...
.dcdddcddd...
.dddcdddcd...
.dddddcccc...
.cccccdddd...
..dd...dd....
..dd...dd....
..dd...dd....
.dd....dd....
.dd....dd....
.hh....hh....
"""

[[layers]]                # x = 6, mirror of x = 0
x = 6
grid = """
.......ddd...
.......ddd...
.............
.............
.............
.............
.............
.............
.............
.............
.............
.............
.............
.............
.............
"""
