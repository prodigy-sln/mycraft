# An adult deer — a stag, standing.
#
# Sliced on `x`, so each layer is a side elevation: the view a four-legged
# animal is recognised from. The first row printed is the antler tips and the
# first column is z = 0, the tail end; columns run z = 0 → 19, so the deer
# faces right.
#
# Revision 3. Revision 2 fixed the three things that were wrong — a torso
# wider than it was deep, planar antlers, and a white stripe severing the
# flank — and broke a fourth in the process, which is the lesson worth
# keeping: **a proportion is a ratio, and deepening one term without
# lengthening the other breaks it from both ends at once.** The barrel went to
# nine courses deep while the legs stayed at eight, so the chest hung below
# the knees and the animal drifted from deer toward moose. Legs are now ten
# and the torso seven, which puts the legs back at about 59 per cent of
# shoulder height — the whitetail read.
#
# The neck grew two courses with it. In revision 2 the neck did lengthen, but
# the body grew faster, so relative to the back line the head was carried
# *lower* than before and the front corners read as a browsing posture. A
# measurement that improves in absolute terms and worsens in ratio is the
# easiest kind to miss.
#
# Kept from revision 2: the torso is five wide and slab-sided, the antlers
# fork a voxel outward on their own layers so the rack branches head-on, and
# the cream lives on the underside faces only — never on the flank, where it
# cut the animal into a brown box on a white shelf.
#
# New here: a voxel of air between the antler's tines so the rack does not
# read as a bush from the front corners, and a pale muzzle tip, which is one
# voxel and among the cheapest deer signals there is.
#
# Carried forward to the next quadruped rather than fixed here: across three
# revisions the animal grew upward — shoulder height 12.5, then 17, then 17.5
# — while the torso stayed about 13 voxels long throughout. Body length is
# therefore 0.73x shoulder height where a cervid wants roughly 1.1x, which
# reads as a leggy young stag rather than as anything wrong. It is the same
# trap as the revision-2 regression with a different pair of terms: **depth is
# coupled to leg length, and shoulder height is coupled to body length.**
# Correcting one pair while never measuring the other is how the drift got in.
#
# Mirror-symmetric about x = 3. 692 filled voxels in a 7 x 29 x 20 box.

schema = 1
name   = "base:deer"
scale  = 16
size   = [7, 29, 20]
origin = [3, 0, 10]       # between the forehooves, on the centreline
slice  = "x"

[palette]
"." = "empty"
"d" = "base:deer_hide"
"c" = "base:fox_cream"
"a" = "base:antler_bone"
"h" = "base:hoof_dark"
"e" = "base:fox_soot"

[[layers]]                # x = 0, the left ear
x = 0
grid = """
....................
....................
....................
....................
....................
...............dd...
...............dd...
....................
....................
....................
....................
....................
....................
