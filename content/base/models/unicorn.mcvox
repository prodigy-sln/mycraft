# A unicorn: a horse in a near-white coat, with a lavender mane and tail and a
# gold horn.
#
# Sliced on `x`, so each layer is a side elevation. The first row printed is
# the horn's tip and the first column is z = 0, behind the tail; columns run
# z = 0 → 21, so the unicorn faces right.
#
# Revision 2, after a reviewer read the fourteen views and said: goat first,
# deer second, horse third — the horn was doing all the work. The lesson, and
# it is the one that generalises: **the horn is the easy part.** A unicorn
# that does not read as a horse before you notice the horn has failed at the
# hard part, and the horse lives entirely in the barrel, the neck and the
# topline. What changed:
#
#   * The barrel was a plank — long, shallow and narrow, which is precisely
#     deer proportion. It is now eight courses deep against nine of leg, which
#     is roughly the horse's one-to-one, and two voxels wider and two shorter.
#   * The topline was a ruler. A horse has withers behind the neck and a croup
#     before the tail; a dead-straight back is a goat's. Both are now a course
#     proud of the barrel.
#   * The neck was a pipe and the head a light box. The neck is deeper front to
#     back and the head is longer, with the jaw and cheek carrying mass at the
#     rear and stepping down to a fine muzzle.
#   * The tail was a decal — flat against the rump, one voxel thick. It now
#     leaves the dock in an arc, stands clear of the haunch with a column of
#     background between them, and falls two voxels thick. That gap is what
#     makes hair read as hair rather than as paint.
#   * The mane was a centre crest: a mohawk from behind and nothing at all from
#     the front, which is half the corners a player walks through. It now
#     drapes down one side of the neck and onto the shoulder, and there is a
#     forelock at the horn's base. **The model is deliberately not mirror-
#     symmetric because of it** — hair does not part down the middle, and a
#     symmetric mane is the reason the front corners had none.
#   * The horn is longer and tapers, two voxels deep at the base to one at the
#     tip, and the tip leans out over the muzzle. It was reading as a little
#     gold cap.
#   * The legs carry shoulder and haunch mass in their top three courses and
#     taper to the cannon below, instead of being four identical posts plugged
#     into a slab.
#
# The coat is near-white rather than white on purpose: at full white the face
# shading is the only thing separating the top of the barrel from its side.
#
# 1270 filled voxels in a 10 x 28 x 22 box.

schema = 1
name   = "base:unicorn"
scale  = 16
size   = [10, 28, 22]
origin = [5, 0, 11]       # between the forehooves, on the centreline
slice  = "x"

[palette]
"." = "empty"
"d" = "base:unicorn_coat"
"m" = "base:unicorn_mane"
"n" = "base:unicorn_horn"
"h" = "base:hoof_dark"
"e" = "base:fox_soot"

[[layers]]                # x = 0, the barrel's outer swell
x = 0
grid = """
......................
......................
......................
......................
......................
......................
......................
......................
......................
......................
......................
......................
......................
