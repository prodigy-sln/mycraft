# Rust
/target/
**/*.rs.bk
*.pdb

# Coverage
/coverage/
*.profraw
*.profdata
lcov.info

# Prospect update artifacts — review and merge, never commit
*.prospect-incoming

# Test harness output
/artifacts/frames/
/artifacts/traces/
/artifacts/loadtest/

# Worlds and runtime state (never commit save data)
/worlds/
*.redb
*.redb-lock

# Server secrets and identity keys
/secrets/
*.key
server-identity.toml

# Local overrides
/config.local.toml
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Profiling
*.tracy
flamegraph.svg
perf.data*

# Conductor working notes (untracked scratchpad)
.claude/pm/

# A clean quit writes the world here. A runtime artifact, never source.
saves/

# The built texture set. Derived from `content/base/textures.toml` by
# `voxforge build`, and never committed — the directory rather than the images,
# so a stray file in it is ignored too. The manifest one level up is source.
/content/base/textures/

# Python bytecode. The measurement scripts beside `content/base/models/` are
# committed and meant to be run, so every contributor who runs one gets this
# directory; ignoring it keeps it out of an accidental sweep.
__pycache__/
